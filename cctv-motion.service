[Unit]
Description=CCTV Motion Detection Trigger
After=cctv-daemon.service cctv-record-api.service
Wants=cctv-daemon.service cctv-record-api.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/cctv_motion_v2.py
Restart=always
RestartSec=10
Restart=always
RestartSec=10
StandardOutput=journal

[Install]
WantedBy=multi-user.target
